{
  "name": "talketeer-backend",
  "description": "A real-time chatting application (Talketeer) backend built using Express.js and Socket.io.",
  "version": "1.0.0",
  "license": "MIT",
  "type": "module",
  "author": {
    "name": "-_YoYo178_-",
    "url": "https://github.com/YoYo178"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/YoYo178/talketeer"
  },
  "main": "./dist/index.js",
  "scripts": {
    "clean": "node --eval \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "dev": "cross-env NODE_ENV=development tsx watch --env-file=./config/.env.development src/index.ts",
    "build": "pnpm run lint && pnpm build:no-lint",
    "build:no-lint": "tsc --build tsconfig.json && tsc-alias",
    "type-check": "tsc --noEmit",
    "start": "cross-env NODE_ENV=production node --env-file=./config/.env.production ./dist/index.js",
    "start:no-env": "cross-env NODE_ENV=production node ./dist/index.js",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "engines": {
    "node": ">=20.6.0"
  },
  "dependencies": {
    "argon2": "^0.44.0",
    "cookie": "^2.0.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.0",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.7.4",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "nodemailer": "^9.0.3",
    "socket.io": "^4.8.3",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.1",
    "@types/nodemailer": "^8.0.1",
    "oxlint": "^1.74.0",
    "prettier": "^3.9.5",
    "tsc-alias": "^1.9.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@11.15.0+sha512.266f8957a30d2be6e9468e5e66bcdedd35a794175f71b067ba8504d686cce1d0c0f429b33c323c3c569ad4891e667574a49ff71d1b89a22cc66f13c65818c578"
}
